#!/bin/bash
set -euo pipefail

# Install pixi into ~/.pixi/bin
curl -fsSL https://pixi.sh/install.sh | bash
export PATH="$HOME/.pixi/bin:$PATH"

cd "${REPO_DIR:-$HOME}"

# Build both environments exactly from pixi.lock
pixi install -e py
pixi install -e r

# Register each environment as a Jupyter kernel
pixi run -e py python -m ipykernel install --user \
  --name pixi-py --display-name "Python (pixi py)"

pixi run -e r R --quiet -e \
  'IRkernel::installspec(name = "pixi-r", displayname = "R (pixi r)")'